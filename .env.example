MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/analyticsagent?retryWrites=true&w=majority
MONGODB_DB_NAME=analyticsagent

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=interview_prep

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM fallback order (auto-switch on Groq 429 rate limit)
LLM_PROVIDERS=groq,gemini,openai,ollama

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini — FREE — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

FRONTEND_URL=https://elegant-rolypoly-d5e460.netlify.app
