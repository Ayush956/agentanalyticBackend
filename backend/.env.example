# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=analyticsagent

# PostgreSQL (auth)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=interview_prep

# JWT
JWT_SECRET=change-me-in-production

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# LLM providers — comma-separated fallback order (auto-failover on rate limits)
LLM_PROVIDERS=gemini,groq,openai,ollama

# Groq free tier — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini — FREE tier — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI — paid fallback (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama local — free, unlimited (install: https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
